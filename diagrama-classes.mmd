classDiagram
    direction LR

    class Usuario {
        +number id
        +string nome
        +string email
        +string perfil
        +boolean ativo
    }

    class Categoria {
        +number id
        +string nome
        +boolean ativa
    }

    class Ocorrencia {
        +number id
        +string titulo
        +number usuarioId
        +number categoriaId
        +string descricao
        +string endereco
        +Nivel urgencia
        +Nivel prioridade
        +Status status
        +number confirmacoes
    }

    class Atendimento {
        +number id
        +number ocorrenciaId
        +number usuarioId
        +Status statusAnterior
        +Status statusNovo
        +Date data
    }

    Usuario "1" --> "0..*" Ocorrencia : usuarioId
    Categoria "1" --> "0..*" Ocorrencia : categoriaId
    Usuario "1" --> "0..*" Atendimento : usuarioId
    Ocorrencia "1" --> "0..*" Atendimento : ocorrenciaId
